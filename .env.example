# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgresql://user:password@your-host.neon.tech/neondb?sslmode=require

# --- RxLab auth (@rxtech-lab/authjs-rxlab) ---
# The OAuth client must allow this app's callback URL and the scopes
# `openid email profile offline_access`. The signing-in admin needs the
# `read:oauth_clients` permission in rxlab-auth — that grant decides which
# applications they can manage here.
AUTH_ISSUER=https://auth.rxlab.app
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (live account) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

# --- Stripe (sandbox account, for test users) ---
# A separate Stripe sandbox account. Test users on the Test tab transact here
# and never against the account above, so nothing they do can reach a real card
# or show up in the live dashboard. Point its webhook endpoint at
# /api/stripe/webhook/sandbox — locally:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook/sandbox
STRIPE_SANDBOX_SECRET_KEY=
STRIPE_SANDBOX_WEBHOOK_SECRET=

# --- Apple App Store in-app purchases (shared App Store Connect issuer) ---
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
# Base64 of the complete .p8 file, including its BEGIN/END lines.
APPLE_IAP_PRIVATE_KEY_BASE64=
# Comma-separated base64 DER Apple root certificates, or a JSON string array.
APPLE_IAP_ROOT_CERTIFICATES_BASE64=

# Authorizes scheduled balance expiry and App Store reconciliation.
CRON_SECRET=

# --- AI assistant (Vercel AI Gateway) ---
AI_GATEWAY_API_KEY=
# Optional override; defaults to anthropic/claude-sonnet-5
AI_MODEL=
# Context compaction. Once a session's prompt passes the threshold, the older
# turns are replaced by a summary and only the recent ones are sent verbatim.
# The stored transcript keeps every message either way. The summarizer is a
# mechanical job, so point it at a cheaper model; it falls back to AI_MODEL.
AI_COMPACT_MODEL=
# Defaults to 50000 estimated tokens
AI_COMPACT_THRESHOLD_TOKENS=

# --- Test cases (the suites on the Test tab) ---
# Suites are arbitrary TypeScript, so a deployment runs them in a Vercel
# Sandbox, never in the request process. Leave TEST_RUNNER unset: it defaults to
# `sandbox` on Vercel and to `local` (a child process of the dev server) off it.
# Setting it to `local` in a deployment is refused.
TEST_RUNNER=
# The URL a run calls back on. Defaults to NEXT_PUBLIC_SITE_URL. A sandbox is a
# separate machine, so this has to be publicly reachable — point it at a tunnel
# to exercise the sandbox driver from a laptop.
TEST_RUNNER_BASE_URL=

# --- Playwright end-to-end runs (set by playwright.config.ts, not by hand) ---
# IS_E2E unlocks the /api/e2e/* test seams; both it and the matching
# x-e2e-secret header are required, so the routes 404 in any normal deployment.
IS_E2E=
E2E_SECRET=
# Redirects the Stripe SDK at the fake server in e2e/fake-stripe.ts
E2E_STRIPE_API_BASE=
</content>
